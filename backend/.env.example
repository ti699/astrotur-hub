NODE_ENV=production
PORT=3002
HOST=0.0.0.0
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars-ou-mais
JWT_EXPIRES_IN=8h
# Origens permitidas do front-end, separadas por vírgula
CORS_ORIGINS=https://portal.seudominio.com.br
DATABASE_URL=postgres://astrotur:senha@db:5432/astrotur
POSTGRES_USER=astrotur
POSTGRES_PASSWORD=senha
POSTGRES_DB=astrotur
# Administrador inicial (criado na primeira migração se não existir)
ADMIN_EMAIL=adm@astroturviagens.com
ADMIN_PASSWORD=defina-uma-senha-forte
# Opcional: integração com sistemas externos para métricas
PATRIMONIO_API_URL=
HELPDESK_API_URL=
# Segredos de servidor para resgate de tickets SSO; gere valores aleatórios
# distintos com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PATRIMONIO_SSO_CLIENT_SECRET=
HELPDESK_SSO_CLIENT_SECRET=
